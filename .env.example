# ─────────────────────────────────────────────────────────────────────────────
# excelle-insights/ai-assistant — host .env template
#
# This file holds CONNECTIONS AND SECRETS only: how to reach the database, how
# to reach the model, and the few identity values a deployment needs. Everything
# behavioural — which tables/columns the assistant may read, features, limits,
# charts, exports, channels — lives in the {prefix}_config table, editable from
# your own settings screen (or SQL), not in this file.
#
# Precedence (lowest → highest):
#   package defaults → your config file → {prefix}_config → these env keys → Config::set()
#
# So an env key still wins when you need a break-glass override. Full reference:
# docs/03-configuration.md
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (only the migrations need this) ─────────────────────────────────
# Runtime PDO is the PDO you already have — the package never opens its own
# connection outside the migration runner.
DB_HOST=127.0.0.1
DB_NAME=your_app
DB_USER=your_user
DB_PASSWORD=
# DB_PORT=3306                       # MySQL 3306 / Postgres 5432 / sqlsrv 1433
# DB_ADAPTER=mysql                   # mysql | pgsql | sqlsrv | sqlite (DB_NAME = file path)
# AI_ASSISTANT_DB_ENV=development     # which phinx environment to migrate

# ─── Own tables ───────────────────────────────────────────────────────────────
# {prefix}_knowledge, {prefix}_schema, {prefix}_config, … created in YOUR
# database by the package migrations. No foreign keys into your tables.
AI_ASSISTANT_TABLE_PREFIX=ai_assistant

# ─── Tenancy (which config row this deployment reads) ────────────────────────
# company_id is only a scoping key inside the package tables. The tenant column
# name itself, and every policy value, is a database setting (schema_policy_json).
# No company model? Set 0 — nothing then queries your tables.
# AI_ASSISTANT_TENANT_ID=0

# ─── LLM provider (any OpenAI-compatible endpoint) ────────────────────────────
# openai | openrouter | together | ollama | vllm | lmstudio | custom
LLM_PROVIDER=openai
LLM_API_KEY=
# LLM_BASE_URL=                      # per-provider default when omitted
LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_REQUEST_TIMEOUT=30
# LLM_APP_URL=https://your-app.example  # sent as HTTP-Referer (OpenRouter)
# Local servers (localhost / 127.0.0.1 / *.local) may run without a key.
# Legacy fallbacks still read: OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL,
# OPENAI_REQUEST_TIMEOUT

# ─── Identity (who the assistant is when it speaks) ───────────────────────────
# Kept here because it is deployment identity, not a per-tenant preference.
# AI_ASSISTANT_DOMAIN_NAME=Your app
# AI_ASSISTANT_NAME=Your assistant

# ─── Everything else is a database setting ─────────────────────────────────────
# Edit it from your settings page with AssistantApi, or straight in SQL:
#
#   $api->handle('config.describe', ['company_id' => 0]);   // every setting + type + options
#   $api->handle('config.save', ['company_id' => 0, 'settings' => [
#       'schema_policy.mode'            => 'allowlist',       // denylist | allowlist | all
#       'schema_policy.allowed_tables'  => 'orders,customers',
#       'schema_policy.blocked_tables'  => 'payments,salaries',
#       'features'                      => 'data_qa,documents,charts,exports,reports',
#       'charts.max_rows'               => 400,
#   ]]);
#
#   UPDATE ai_assistant_config
#      SET schema_policy_json = '{"schema_policy.mode":"allowlist","schema_policy.allowed_tables":["orders","customers"]}'
#    WHERE company_id = 0;
#
# Values accept yes/no/on/off/1/0 for booleans and CSV or arrays for lists; a
# null value clears an override so the file/default applies again. Secrets are
# never stored there — see src/Support/ConfigCatalog.php for what is editable.

# ─── Optional boot config ─────────────────────────────────────────────────────
# Point at your own published config array/file (still wins over the defaults,
# still loses to the settings table):
# AI_ASSISTANT_CONFIG_FILE=/path/to/your-app/config/ai-assistant.php
# Pre-rename aliases still honoured (remove when your install is on the new keys):
# AI_WHATSAPP_TABLE_PREFIX, AI_WHATSAPP_AUTO_REPLY, AI_WHATSAPP_FALLBACK_TEMPLATE,
# AI_WHATSAPP_COMPANY_ID, AI_WHATSAPP_SESSION_TURNS, AI_WHATSAPP_BOOKING_HOOK
