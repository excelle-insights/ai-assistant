# ─────────────────────────────────────────────────────────────────────────────
# ai-assistant — host .env guide
#
# The package is configured ENTIRELY from the host app's .env. There is no
# package-local config. One LLM block powers every AI: WhatsApp auto-reply,
# guide, diagnosis and analysis.
#
# Any OpenAI-compatible endpoint works — only base URL + key + model change.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM provider (provider-agnostic) ────────────────────────────────────────
# LLM_PROVIDER: openai | openrouter | together | ollama | vllm | lmstudio | custom
LLM_PROVIDER=openai
LLM_API_KEY=
# LLM_BASE_URL=                      # provider default when omitted
LLM_MODEL=gpt-4o
LLM_REQUEST_TIMEOUT=30
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Vision (image diagnosis) — must be a vision-capable model on LLM_BASE_URL.
# LLM_VISION_MODEL=gpt-4o

# Audio (voice notes) — needs an OpenAI-compatible /audio/transcriptions
# endpoint. Falls back to LLM_BASE_URL / LLM_API_KEY when not set.
LLM_TRANSCRIBE_MODEL=whisper-1
# LLM_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# LLM_TRANSCRIBE_API_KEY=

# Optional extra request headers (JSON) for providers that require them.
# LLM_EXTRA_HEADERS={"X-Custom-Header":"value"}

# Legacy names are still accepted as fallbacks:
# OPENAI_API_KEY, OPENAI_MODEL, OPENAI_BASE_URL,
# OPENAI_REQUEST_TIMEOUT, OPENAI_WHISPER_MODEL

# ─── Provider examples (pick one, then set the block above) ──────────────────
#
# OpenAI (embeddings + Whisper audio work out of the box)
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o
#
# DeepSeek (OpenAI-compatible; no embeddings endpoint → keyword search)
#   LLM_PROVIDER=custom
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
#
# OpenCode Zen (pay-as-you-go gateway; /chat/completions models only)
#   LLM_PROVIDER=custom
#   LLM_BASE_URL=https://opencode.ai/zen/v1
#   LLM_MODEL=deepseek-v4.1-flash
#
# OpenCode Go ($10/mo subscription; coding-agent traffic, sends a session header)
#   LLM_PROVIDER=custom
#   LLM_BASE_URL=https://opencode.ai/zen/go/v1
#   LLM_MODEL=deepseek-v4.1-flash
#
# OpenRouter (Claude/GPT/Gemini/Llama via one key)
#   LLM_PROVIDER=openrouter
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=openai/gpt-4o
#
# Ollama (local, no key needed)
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
#   LLM_EMBEDDING_MODEL=nomic-embed-text

# ─── AI assistant package ────────────────────────────────────────────────────
AI_ASSISTANT_AUTO_REPLY=true
AI_ASSISTANT_TABLE_PREFIX=ai_assistant
AI_ASSISTANT_FALLBACK_TEMPLATE=0
# AI_ASSISTANT_TENANT_ID=0           # single-tenant apps without a companies table

# Legacy (pre-rename) package keys — remove when migration is done:
# AI_WHATSAPP_TABLE_PREFIX, AI_WHATSAPP_AUTO_REPLY,
# AI_WHATSAPP_FALLBACK_TEMPLATE, AI_WHATSAPP_COMPANY_ID, AI_WHATSAPP_SESSION_TURNS
