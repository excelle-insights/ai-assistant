{
    "name": "excelle-insights/ai-assistant",
    "description": "Standalone AI assistant package — trainable, reusable across apps and LLM providers, one AI for messaging, guidance, diagnosis and analysis",
    "type": "library",
    "keywords": ["ai", "assistant", "llm", "openai", "whatsapp", "chatbot"],
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.0",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "ExcelleInsights\\AiAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExcelleInsights\\AiAssistant\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
