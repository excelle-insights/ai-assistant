{
    "name": "excelle-insights/ai-whatsapp",
    "description": "Standalone AI WhatsApp reply package — trainable, reusable across apps, uses host OpenAI like excelle-insights/whatsapp",
    "type": "library",
    "keywords": ["whatsapp", "ai", "openai", "chatbot"],
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.0",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "ExcelleInsights\\AiWhatsapp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExcelleInsights\\AiWhatsapp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
